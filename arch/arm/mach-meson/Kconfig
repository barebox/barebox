if ARCH_MESON

config ARCH_MESON_GX
	bool "Amlogic Meson GXBB, GXL and GXM"
	help
	  Say Y here to support the Amlogic GXBB (S905), GXL (S905X, S905D,
	  S905W, S805X, S805Y) and GXM (S912) SoCs. barebox is started as
	  BL33 by the vendor firmware, as barebox-dt-2nd.img with the
	  board's device tree appended.

config ARCH_MESON_G12
	bool "Amlogic Meson G12A, G12B and SM1"
	help
	  Say Y here to support the Amlogic G12A, G12B and SM1 SoCs. barebox
	  is started as BL33 by the vendor firmware, as barebox-dt-2nd.img
	  with the board's device tree appended.

endif
