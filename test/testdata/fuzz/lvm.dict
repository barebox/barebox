#
# libfuzzer dictionary for the "lvm" fuzzer, which exercises the LVM2
# header parser. Pass it with -dict=, e.g.
#
#   images/fuzz-lvm -dict=test/testdata/fuzz/lvm.dict

"LABELONE"
"LVM2 001"
" LVM2 x[5A%r0N*>"

# Small le32 constants
"\x00\x00\x00\x00"
"\x01\x00\x00\x00"
"\x02\x00\x00\x00"
"\x04\x00\x00\x00"
"\x08\x00\x00\x00"
"\x10\x00\x00\x00"
"\x40\x00\x00\x00"
"\x80\x00\x00\x00"

